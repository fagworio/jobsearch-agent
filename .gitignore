.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.env
data/*.db
data/applications/*/
data/preflight/
data/public-preflight/
data/browser_profiles/
# Diario de envios do V2: marcador de exatamente-uma-vez, fora do git de
# proposito (contem href/currículo/hashes do candidato).
data/v2-submissions/
# Relatórios e currículos personalizados V2 são dados operacionais locais.
data/v2-auto/
data/v2-discovery/
data/v2-resumes/
data/v2-agent/
data/v2-answers.json
# Politica fail-closed para dados do candidato: qualquer arquivo novo em
# profile/ fica IGNORADO por padrao e so entra no repositorio se for
# explicitamente liberado abaixo. Um arquivo concreto de respostas
# (answers.canonical.yaml) vazou nome, e-mail e nacionalidade reais por a regra
# anterior listar apenas *.local.yaml.
profile/*
!profile/answers.yaml
!profile/answers.template.yaml
!profile/application_policy.yaml
!profile/career_profile.yaml
!profile/job_targets.yaml
!profile/locked_facts.yaml
!profile/preferences.yaml
!profile/v2-facts.template.json
!profile/v2-answers.template.json
profile/*.local.yaml
tmp/pdfs/
work/
dist/
extension/node_modules/
extension/dist/
*.egg-info/

# Credenciais locais de integracao (JSA-CONF-006). O caminho padrao fica fora do
# repositorio (~/.config/jobsearch-agent/gmail); isto e defesa em profundidade
# para quem apontar JOBSEARCH_GMAIL_DIR para dentro do projeto.
# Padrao amplo de proposito: `client_secret_gmail.json` (uma copia deixada na
# raiz do repositorio) passava pelas entradas exatas e aparecia como untracked
# num `git add -A`.
client_secret*.json
token.json
gmail/
